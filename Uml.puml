@startuml SimulazioneCentroSmistamento

class MainSimulazione {
  + {static} main(args: String[]): void
}

class CentroSmistamento {
  - pacchiDisponibili: int
  - pacchiIniziali: int
  - tentativiTotali: AtomicInteger
  - assegnazioniRiuscite: AtomicInteger
  - assegnazioniFallite: AtomicInteger
  + CentroSmistamento(pacchiIniziali: int)
  + prelevaPacco(): boolean
  + incrementaTentativo(): void
  + incrementaFallito(): void
  + stampaReport(): void
  + getPacchiDisponibili(): int
}

class Operatore {
  - idOperatore: int
  - centro: CentroSmistamento
  - pacchiAssegnatiDaMe: int
  + Operatore(id: int, centro: CentroSmistamento)
  + run(): void
}

class Thread {
  + start(): void
  + run(): void
  + join(): void
}

Thread <|-- Operatore
MainSimulazione ..> CentroSmistamento
MainSimulazione ..> Operatore
Operatore --> CentroSmistamento

@enduml